{
  "name": "fillm",
  "version": "1.0.0",
  "description": "FIL(L)M - Fix It, LLM: A browser extension for capturing web page issues",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "npm run build:chrome && npm run build:safari",
    "build:chrome": "vite build --config vite.config.chrome.ts",
    "build:safari": "vite build --config vite.config.safari.ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@types/chrome": "^0.0.287",
    "jszip": "^3.10.1",
    "typescript": "^5.3.3",
    "vite": "^5.4.11"
  },
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "safari-extension",
    "bug-reporting",
    "llm"
  ],
  "author": "",
  "license": "MIT"
}
