{
  "manifest_version": 3,
  "name": "FIL(L)M - Fix It, LLM",
  "version": "1.0.0",
  "description": "Capture web page issues and send them to Claude for analysis",
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "FIL(L)M - Fix It, LLM"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "activate-capture": {
      "suggested_key": {
        "default": "Command+Shift+F"
      },
      "description": "Activate capture mode"
    }
  }
}
